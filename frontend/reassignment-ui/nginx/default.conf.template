server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # The UI calls the API on its own origin under /api, so it works from any host
    # (no hard-coded backend address, no CORS). BACKEND_URL is set in the Dockerfile
    # (default http://backend:8080, the compose service) and can be overridden at run time.
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        # Server-Sent Events (live AI reasoning): pass tokens through as they arrive
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
    }

    # Angular routes (/queue, /fleet, ...) are client-side: serve index.html for them
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hashed build assets can be cached forever; index.html must not be
    location ~* \.(?:js|css|woff2?|ico|svg|png)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
