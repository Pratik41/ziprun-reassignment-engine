# Copy to .env (git-ignored) and fill in. Everything is optional except OPS_PASSWORD.
GEMINI_API_KEY=
GROQ_API_KEY=
# ai | rule-based (first-run default; a choice made in the UI is remembered)
ROUTING_STRATEGY=ai
# Agents whose phone app stops sending heartbeats for this long are marked Offline
AGENTS_HEARTBEAT_TIMEOUT_SECONDS=60
# Password for the bundled PostgreSQL database
DATABASE_PASSWORD=ziprun
# Sign-in for the console and API. REQUIRED for Docker: at least 10 characters, not "ziprun"
# (the prod profile refuses to start otherwise).
OPS_USERNAME=ops
OPS_PASSWORD=
# Optional shared secret agents' phone apps send as X-Agent-Token on heartbeats
AGENT_APP_TOKEN=
# Show the Fleet page's phone-app simulator (a demo tool)
DEMO_TOOLS=false
# DEBUG also logs every AI prompt and reply
LOG_LEVEL=INFO
